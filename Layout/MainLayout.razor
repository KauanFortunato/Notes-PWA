@inherits LayoutComponentBase
@using Notes.Data
@using Notes.Pages.Components

@inject NoteService NoteService
@inject WorkspaceService WorkspaceService
@inject AppData AppData
@inject FunctionsUseful FunctionsUseful

<header>
    <div class="top-bar-box">
        <section class="top-bar-section">
            <nav class="toolbar-items">
                <div class="toolbar-item-left">
                    <button class="navbar-toggler" @onclick="SidebarActive">
                        <span class="bi bi-list icon-bootstrap"></span>
                    </button>

                    <div class="search-container desktop">
                        <input id="searchbar-desktop" type="text" name="searchbar-desktop" placeholder="Pesquisar notas"
                               @onkeyup='() => FunctionsUseful.Search("searchbar-desktop")' @onfocus="FunctionsUseful.RemoveDate" @onblur="FunctionsUseful.AddDate" />
                        <label class="navbar-toggler" for="searchbar-desktop">
                            <span class="bi bi-search icon-bootstrap lupa"></span>
                        </label>
                    </div>
                </div>

                <div class="tool-bar-title">
                    <div class="workspace-info">
                        <span class="tool-bar-title-text" id="header-title">Workspace</span>
                    </div>
                </div>

                <input id="more-button" name="more-button" type="checkbox" />
                <div class="toolbar-item-right">
                    <label class="visu-tg-box">
                        <input type="checkbox" checked="@visualizationType" @onchange="ToggleVisualization">
                        <span class="bi bi-list-ul icon-bootstrap icon-list"></span>
                        <span class="bi bi-grid-fill icon-bootstrap icon-grid"></span>
                        <span class="slider"></span>
                    </label>

                    <label for="more-button">
                        <span class="bi bi-three-dots-vertical icon-bootstrap"></span>
                    </label>
                </div>

                <div class="more-menu-box">
                    <div class="more-menu">
                        <div class="menu-collapse-container">
                            <input id="ordenar-collapse" name="ordenar-collapse" type="checkbox" />
                            <label for="ordenar-collapse" class="more-menu-item">
                                <span class="bi bi-arrow-down-up icon-more-menu"></span>
                                <span class="item-span order">Ordenar<span class="bi bi-caret-down-fill icon-more-menu"></span></span>
                            </label>

                            <div class="menu-collapse-box">
                                <div class="menu-collapse" @onclick='() => AppData.ChangeGroupType("data")'>
                                    <span class="bi bi-calendar-event icon-more-menu"></span>
                                    <span>Por data</span>
                                </div>
                                <div class="menu-collapse" @onclick='() => AppData.ChangeGroupType("titulo")'>
                                    <span class="bi bi-fonts icon-more-menu"></span>
                                    <span>Por titulo</span>
                                </div>
                            </div>
                        </div>

                        <span class="separation"></span>
                        <div class="more-menu-item">
                            <span class="bi bi-gear icon-more-menu"></span>
                            <span class="item-span">Configuração</span>
                        </div>
                    </div>
                </div>
            </nav>
        </section>
    </div>
</header>

<div class="main-content">
    <nav id="side-bar-container" class="side-bar-container">
        <div class="side-bar-fade" @onclick="SidebarClose"></div>
        <div class="top-items">
            <h2>
                <span>Workspaces</span>
            </h2>
            <div class="top-bar-tools">
                <button class="add-workspace-button" type="button" @onclick="AddWorkspace" title="Adicionar Workspace">
                    <span class="bi bi-plus"></span>
                </button>

                <button id="close-side-bar" @onclick="SidebarClose" title="Fechar barra lateral">
                    <span class="bi bi-x-lg icon-bootstrap"></span>
                </button>
            </div>
        </div>

        <div class="search-container-workspaces">
            <div class="search-box" @onkeyup='() => FunctionsUseful.SearchWorkspace("searchbar-workspaces")'>
                <label class="search-icon-label" for="searchbar-workspaces">
                    <span class="bi bi-binoculars"></span>
                </label>
                <input id="searchbar-workspaces" type="text" name="searchbar-workspaces" placeholder="Pesquisar workspace" />
            </div>
        </div>

        <div class="workspaces-container">
            @foreach (var workspace in workspaces)
            {
                if (showEditInterface && workspace.Id == workspaceSelecionado.Id)
                {
                    <div class="workspace-on-edit" @onclick="HideEditInterface"></div>
                    <WorkspaceEdit
                        WorkSpaceSelecionado="workspaceSelecionado"
                        OnSave="SaveEditWorkspace"/>
                }
                else
                {

                    <div class="workspace-info-container" id="wk-ct-@(workspace.Id)">
                        <span class="bi bi-clipboard2-fill icon-workspace" id="workspace-@(workspace.Id)" style="background-color: @workspace.Color"></span>

                        <a class="nav-link active" aria-current="page" href="/workspace/@workspace.Id">@workspace.Name</a>

                        <div class="workspace-tools-box">
                            <div class="workspace-tools">
                                <button class="navbar-toggler" type="button" @onclick="() => ShowEditInterface(workspace)">
                                    <span class="bi bi-pencil icon-bootstrap small"></span>
                                </button>

                                <button class="navbar-toggler" type="button" @onclick="() => DeleteWorkspace(workspace.Id)">
                                    <span class="bi bi-trash3 icon-bootstrap small trash"></span>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </nav>

    @Body
</div>

@code
{
    private List<Workspace> workspaces = new List<Workspace>();
    private Workspace? workspaceSelecionado = null;
    private bool visualizationType = false;
    private bool showEditInterface = false;
    private Workspace workspaceUsed = new Workspace();

    protected override async Task OnInitializedAsync()
    {
        await AtualizarWorkspacesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await FunctionsUseful.DetectDevice();
            await SideBarIni();
            await VisualizationIni();
        }
        // workspaceUsed = await WorkspaceService.GetWorkspaceAsync(AppData.WorkspaceUsedId);
    }

    private async Task AtualizarWorkspacesAsync()
    {
        workspaces = await WorkspaceService.GetAllWorkspacesAsync();
    }

    private async Task AddWorkspace()
    {
        Workspace newWorkspace = new Workspace();
        await WorkspaceService.AddWorkspaceAsync(newWorkspace);
        await AtualizarWorkspacesAsync();
    }

    private async Task ToggleVisualization(ChangeEventArgs e)
    {
        if (!visualizationType)
        {
            await VisualizationGrid();
        }
        else
        {
            await VisualizationList();
        }

        visualizationType = (bool)e.Value;
    }

    private async Task DeleteWorkspace(int id)
    {
        List<Note> notes = new List<Note>();
        notes = await NoteService.GetAllNotesAsync();

        foreach(var note in notes)
        {
            if (note.WorkspaceId == id)
            {
                await NoteService.DeleteNoteAsync(note.Id);
            }
        }
        await WorkspaceService.DeleteWorkspaceAsync(id);
        await AtualizarWorkspacesAsync();
    }

    private void ShowEditInterface(Workspace workspace)
    {
        workspaceSelecionado = workspace;
        showEditInterface = true;
    }

    private async Task HideEditInterface()
    {
        workspaceSelecionado = null;
        showEditInterface = false;
        await AtualizarWorkspacesAsync();
    }

    private async Task SaveEditWorkspace()
    {
        await WorkspaceService.UpdateWorkspaceAsync(workspaceSelecionado);
        await HideEditInterface();
    }

    private async Task SidebarClose()
    {

        await FunctionsUseful.SidebarClose();
        await NoteService.SetLocalStorageItem("sideBar", "false");
    }

    private async Task SidebarActive()
    {
        await FunctionsUseful.SidebarActive();
        await NoteService.SetLocalStorageItem("sideBar", "true");
    }

    private async Task SideBarIni()
    {
        var item = Convert.ToBoolean(await NoteService.GetLocalStorageItem("sideBar"));

        if (item)
        {
            await SidebarActive();
        }else
        {
            await SidebarClose();
        }
    }

    private async Task VisualizationGrid()
    {
        await FunctionsUseful.SetClassItem("all-notes", "all-notes-grid");
        await NoteService.SetLocalStorageItem("visualization", "true");
    }

    private async Task VisualizationList()
    {
        await FunctionsUseful.RemoveClassItem("all-notes", "all-notes-grid");
        await NoteService.SetLocalStorageItem("visualization", "false");
    }

    private async Task VisualizationIni()
    {
        var item = Convert.ToBoolean(await NoteService.GetLocalStorageItem("visualization"));

        if (item)
        {
            await VisualizationGrid();
            visualizationType = item;
        }
        else
        {
            await VisualizationList();
            visualizationType = item;
        }
    }
}